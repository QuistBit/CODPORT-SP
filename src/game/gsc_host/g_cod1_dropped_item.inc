 if(!input||!out||!DropBuffers(input,sizeof(*input),out,sizeof(*out),error,cap))return 0;q=*input;if(q.cwIndex<0||q.cwIndex>=CW_Count()||(q.angular!=0&&q.angular!=1)||q.reserve< -1||q.clip< -1||!LiveItemFinite(q.origin)||!LiveItemFinite(q.angles)||!LiveItemFinite(q.velocity)||!LiveItemFinite(q.angularDelta)||!DropBegin(NULL))return 0;cod1DropCall.source=input;cod1DropCall.request=q;memset(&staged,0,sizeof(staged));
