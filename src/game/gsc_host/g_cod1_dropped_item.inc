int G_Cod1DroppedItemRead(const GscEntityRef*input,c1dfState*out,char*error,size_t cap){GscEntityRef ref;C1DroppedRow*r;int ok=0;if(!input||!out||!DropBuffers(input,sizeof(*input),out,sizeof(*out),error,cap))return 0;ref=*input;if(ref.slot>=MAX_GENTITIES||!LiveItemRefEqual(&ref,&cod1Drops.rows[ref.slot].ref)||!DropBody(cod1Drops.rows+ref.slot)||!DropBegin(&ref))return 0;r=cod1Drops.rows+ref.slot;if(DropModelCurrent(r)&&!memcmp(input,&ref,sizeof(ref))&&DropBuffers(input,sizeof(*input),out,sizeof(*out),error,cap)&&DropFence(NULL)){*out=r->state;ok=1;}DropEnd();return ok;}
static int DropReadRegistration(int cap,char*error,size_t size){cod1AmmoRegistryReceipt_t*registry=calloc(1,sizeof(*registry));cod1WeaponRegistrationReceipt_t*registration=calloc(1,sizeof(*registration));int ok=0;if(!registry||!registration)goto done;if(!CAR_Build(registry)||!DropFence(NULL)||!G_Cod1ReadWeaponRegistration(registry,cap,registration,error,size,DropFence,NULL))goto done;memcpy(&cod1DropCall.registry,registry,sizeof(*registry));memcpy(&cod1DropCall.registration,registration,sizeof(*registration));cod1DropCall.registered=1;ok=DropFence(NULL);done:free(registry);free(registration);return ok;}
