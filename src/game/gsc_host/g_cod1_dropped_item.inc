static int DropBegin(const GscEntityRef*ref){if(cod1DropCall.busy){cod1DropCall.cancelled=1;return 0;}if(!DropMap()||cod1Drops.serial==UINT64_MAX)return 0;memset(&cod1DropCall,0,sizeof(cod1DropCall));cod1DropCall.busy=1;cod1DropCall.epoch=cod1Drops.epoch;cod1DropCall.key=cod1Drops.key;cod1DropCall.serial=++cod1Drops.serial;cod1DropCall.current=cod1Drops.current;cod1DropCall.user=cod1Drops.user;cod1DropCall.time=level.time;cod1DropCall.count=level.num_entities;if(ref){if(!G_Cod1EntitySameAllocation(ref)){cod1DropCall.busy=0;return 0;}cod1DropCall.ref=*ref;cod1DropCall.hasItem=1;cod1DropCall.before=g_entities[ref->slot];}if(!DropFence(NULL)){cod1DropCall.busy=0;return 0;}return 1;}
