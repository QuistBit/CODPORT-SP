static int DropMap(void){return !cod1DropsStopping&&LiveItemMap()&&cod1Drops.epoch==cod1EntityEpoch&&cod1Drops.key&&cod1Drops.current;}
static int DropQueuePinned(void){int i;if(!cod1DropCall.queuePinned)return 1;if(!G_Cod1EntitySameAllocation(&cod1DropCall.player)||memcmp(cod1DropCall.playerOrigin,g_entities[0].r.currentOrigin,12)||memcmp(cod1DropCall.queueRefs,cod1Drops.queue,sizeof(cod1Drops.queue)))return 0;for(i=0;i<32;i++)if(cod1DropCall.queueRefs[i].epoch){int live=G_Cod1EntitySameAllocation(cod1DropCall.queueRefs+i)?1:0;if(live!=cod1DropCall.queueAlive[i]||(live&&memcmp(cod1DropCall.queueOrigins[i],g_entities[cod1DropCall.queueRefs[i].slot].r.currentOrigin,12)))return 0;}return 1;}
