static int DropNativeId(int port){if(port==ENTITYNUM_NONE)return 2047;if(port==ENTITYNUM_WORLD)return 2046;return port>=0&&port<ENTITYNUM_WORLD?port:-1;}
static int DropPortId(int native){if(native==2047)return ENTITYNUM_NONE;if(native==2046)return ENTITYNUM_WORLD;return native>=0&&native<ENTITYNUM_WORLD?native:-1;}
static int DropKind(int native){return native==0?TR_STATIONARY:native==2?TR_LINEAR:native==5?TR_GRAVITY:native==8?TR_GRAVITY_PAUSED:-1;}
static int DropBody(const C1DroppedRow*r){const gentity_t*e;if(!r||r->broken||!r->ref.epoch||!G_Cod1EntitySameAllocation(&r->ref))return 0;e=g_entities+r->ref.slot;if(!CW_Get(r->cwIndex)||CW_Get(r->cwIndex)->hash!=r->definitionHash||CW_WeaponRoot(r->wp)!=CW_FamilyRoot(r->cwIndex))return 0;return !e->client&&!e->aiCharacter&&!cod1ActorByEntity[r->ref.slot]&&!e->r.bmodel&&!e->neverFree&&!e->physicsObject&&e->s.eType==ET_ITEM&&e->s.modelindex==r->itemIndex&&e->s.modelindex2==r->modelSlot&&e->item==bg_itemlist+r->itemIndex&&e->item->giType==IT_WEAPON&&e->item->giTag==r->wp&&e->classname==r->classname&&!strcmp(e->classname,r->classname)&&e->touch==Touch_Item_Auto&&!e->use&&e->cod1DroppedAmmo&&e->count==r->reserve&&e->cod1DropClip==(r->clip<0?0:r->clip)&&e->cod1DropReserve==(r->reserve<0?0:r->reserve)&&!e->wait&&!e->random&&!e->spawnflags&&!e->target&&!e->targetname&&e->r.contents==(CONTENTS_TRIGGER|CONTENTS_ITEM)&&e->r.svFlags==SVF_USE_CURRENT_ORIGIN&&(e->flags&FL_DROPPED_ITEM)&&!(e->flags&FL_NODRAW)&&!(e->s.eFlags&(EF_NODRAW|EF_SPINNING))&&e->r.ownerNum==ENTITYNUM_NONE&&e->s.pos.trType==DropKind(r->state.kind)&&e->s.pos.trTime==r->state.time&&!e->s.pos.trDuration&&!memcmp(e->s.pos.trBase,r->state.base,12)&&!memcmp(e->s.pos.trDelta,r->state.delta,12)&&!memcmp(e->r.currentOrigin,r->state.origin,12)&&!memcmp(e->s.origin,r->state.origin,12)&&e->s.apos.trType==DropKind(r->state.angularKind)&&e->s.apos.trTime==r->state.angularTime&&!e->s.apos.trDuration&&!memcmp(e->s.apos.trBase,r->state.angularBase,12)&&!memcmp(e->s.apos.trDelta,r->state.angularDelta,12)&&!memcmp(e->r.currentAngles,r->state.angles,12)&&!memcmp(e->s.angles,r->state.angles,12)&&!memcmp(e->r.mins,r->state.mins,12)&&!memcmp(e->r.maxs,r->state.maxs,12)&&e->s.groundEntityNum==DropPortId(r->state.ground)&&e->physicsBounce==0&&(!e->think||e->think==G_FreeEntity);}
static int DropModelCurrent(const C1DroppedRow*r){cod1ModelResourceReference_t q=r->model,expected,result;char name[MAX_STRING_CHARS];q.operation=COD1_MODEL_RESOURCE_VALIDATE;expected=q;if(!DropFence(NULL)||trap_Cod1ModelResourceReference(&q,&result)!=1||!DropFence(NULL)||memcmp(&q,&expected,sizeof(q))||memcmp(&result,&expected,sizeof(result)))return 0;trap_GetConfigstring(CS_MODELS+r->modelSlot,name,sizeof(name));return DropFence(NULL)&&!strcmp(name,r->model.name);}
static void DropApply(C1DroppedRow*r,const c1dfState*s){gentity_t*e=g_entities+r->ref.slot;r->state=*s;e->s.pos.trType=DropKind(s->kind);e->s.pos.trTime=s->time;e->s.pos.trDuration=0;memcpy(e->s.pos.trBase,s->base,12);memcpy(e->s.pos.trDelta,s->delta,12);memcpy(e->r.currentOrigin,s->origin,12);memcpy(e->s.origin,s->origin,12);e->s.apos.trType=DropKind(s->angularKind);e->s.apos.trTime=s->angularTime;e->s.apos.trDuration=0;memcpy(e->s.apos.trBase,s->angularBase,12);memcpy(e->s.apos.trDelta,s->angularDelta,12);memcpy(e->r.currentAngles,s->angles,12);memcpy(e->s.angles,s->angles,12);e->s.groundEntityNum=DropPortId(s->ground);cod1DropCall.before=*e;}
static int DropLink(void*u,const c1dfState*s){C1DroppedRow*r=u;gentity_t after;if(!DropFence(NULL)||!DropBody(r))return 0;DropApply(r,s);trap_LinkEntity(g_entities+r->ref.slot);if(!G_Cod1EntitySameAllocation(&r->ref))return 0;after=g_entities[r->ref.slot];after.r.linked=cod1DropCall.before.r.linked;after.r.linkcount=cod1DropCall.before.r.linkcount;memcpy(after.r.absmin,cod1DropCall.before.r.absmin,12);memcpy(after.r.absmax,cod1DropCall.before.r.absmax,12);if(memcmp(&after,&cod1DropCall.before,sizeof(after)))return 0;cod1DropCall.before=g_entities[r->ref.slot];return DropFence(NULL)&&DropBody(r)&&g_entities[r->ref.slot].r.linked;}
static int DropTrace(void*u,int capsule,const float start[3],const float mins[3],const float maxs[3],const float end[3],int pass,unsigned mask,c1dfTrace*out){cod1SpatialTraceQuery_t q;trace_t tr;int id=DropPortId(pass),status;(void)u;if(!capsule||id<0||!DropFence(NULL))return 0;memset(&q,0,sizeof(q));q.version=COD1_SPATIAL_VERSION;q.bytes=sizeof(q);memcpy(q.start,start,12);memcpy(q.end,end,12);memcpy(q.mins,mins,12);memcpy(q.maxs,maxs,12);q.passEntity[0]=id;q.passEntity[1]=ENTITYNUM_NONE;q.contentsMask=mask;status=trap_Cod1SpatialCapsuleTrace(&q,&tr);if(status!=COD1_SPATIAL_OK||!DropFence(NULL)||!isfinite(tr.fraction)||tr.fraction<0||tr.fraction>1||!LiveItemFinite(tr.endpos)||!LiveItemFinite(tr.plane.normal)||DropNativeId(tr.entityNum)<0)return 0;out->fraction=tr.fraction;memcpy(out->end,tr.endpos,12);memcpy(out->normal,tr.plane.normal,12);out->ground=DropNativeId(tr.entityNum);out->startsolid=tr.startsolid?1:0;return 1;}
static int DropContents(void*u,const float p[3],int pass,unsigned mask,int*out){int result;(void)u;if(pass!=-1||mask!=0x80000000u||!DropFence(NULL))return 0;result=trap_PointContents(p,-1);if(!DropFence(NULL))return 0;*out=(uint32_t)result&mask;return 1;}
static int DropRemove(void*u,c1dfState*s){C1DroppedRow*r=u;GscEntityRef ref=r->ref;if(!DropFence(NULL)||!DropBody(r))return 0;cod1DropCall.hasItem=0;G_FreeEntity(g_entities+ref.slot);if(G_Cod1EntitySameAllocation(&ref))return 0;memset(r,0,sizeof(*r));s->alive=0;return DropFence(NULL);}
