 def=CW_Get(q.cwIndex);if(!def||!registered||!registered->descriptor.model_present[0]||!registered->descriptor.models[0][0]||strlen(registered->descriptor.classname)>=sizeof(staged.classname)||registered->models[0].configstringSlot<=0||registered->models[0].configstringSlot>=MAX_MODELS)goto done;
 for(i=1;i<WP_NUM_WEAPONS;i++)if(CW_WeaponRoot(i)==CW_FamilyRoot(q.cwIndex)){if(wp!=-1)goto done;wp=i;}if(wp<1||q.clip>(int)CW_Number(def,"clipSize")||q.reserve>(int)CW_Number(def,"maxAmmo"))goto done;
