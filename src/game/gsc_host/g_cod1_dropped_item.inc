}

int G_Cod1DroppedItemPickupOwner(gentity_t*e,GscEntityRef*out){GscEntityRef ref;C1DroppedRow*r;if(!e||!out||!DropBuffers(NULL,0,out,sizeof(*out),NULL,0)||!G_Cod1EntityCapture(e,&ref)||ref.slot>=MAX_GENTITIES)return 0;r=cod1Drops.rows+ref.slot;if(!LiveItemRefEqual(&ref,&r->ref))return 0;if(r->touching!=1||!DropBody(r))return -1;*out=ref;return 1;}
int G_Cod1DroppedItemPickupBegin(gentity_t*e,gentity_t*player,GscEntityRef*out){GscEntityRef ref,p;C1DroppedRow*r;int ok=0;if(!e||!out||!DropBuffers(NULL,0,out,sizeof(*out),NULL,0)||!G_Cod1EntityCapture(e,&ref)||ref.slot>=MAX_GENTITIES)return 0;r=cod1Drops.rows+ref.slot;if(!LiveItemRefEqual(&ref,&r->ref))return 0;if(DropActorBusy())return -1;if(cod1DropPickup.active){cod1DropPickup.cancelled=1;return -1;}if(r->touching){r->touching=-1;return -1;}if(!DropBody(r)||!G_Cod1EntityCapture(player,&p)||p.slot>=MAX_CLIENTS||p.slot>=(unsigned)level.maxclients||!level.clients||player->client!=level.clients+p.slot||player->client->ps.aiChar)return -1;
 memset(&cod1DropPickup,0,sizeof(cod1DropPickup));cod1DropPickup.active=1;cod1DropPickup.item=ref;cod1DropPickup.player=p;cod1DropPickup.body=*player;cod1DropPickup.client=*player->client;r->touching=1;
 if(DropBegin(&ref)){ok=DropPickupPlayer(1)&&DropModelCurrent(r)&&DropFence(NULL)&&r->touching==1&&DropPickupPlayer(1);DropEnd();}if(!ok){if(LiveItemRefEqual(&ref,&r->ref))r->touching=0;memset(&cod1DropPickup,0,sizeof(cod1DropPickup));return -1;}*out=ref;return 1;}
int G_Cod1DroppedItemPickupCurrent(const GscEntityRef*input){GscEntityRef ref;C1DroppedRow*r;int ok=0;if(!input||!DropBuffers(input,sizeof(*input),NULL,0,NULL,0))return 0;ref=*input;if(ref.slot>=MAX_GENTITIES||!LiveItemRefEqual(&ref,&cod1DropPickup.item)||!DropPickupPlayer(1))return 0;r=cod1Drops.rows+ref.slot;if(!LiveItemRefEqual(&ref,&r->ref)||r->touching!=1||!DropBody(r)||!DropBegin(&ref))return 0;ok=DropPickupPlayer(1)&&DropModelCurrent(r)&&DropFence(NULL)&&r->touching==1&&!memcmp(input,&ref,sizeof(ref))&&DropPickupPlayer(1);DropEnd();return ok;}
int G_Cod1DroppedItemPickupPlayerAlive(const GscEntityRef*input,const gentity_t*player){return input&&DropBuffers(input,sizeof(*input),NULL,0,NULL,0)&&LiveItemRefEqual(input,&cod1DropPickup.item)&&player==g_entities+cod1DropPickup.player.slot&&DropPickupPlayer(0);}
void G_Cod1DroppedItemPickupEnd(const GscEntityRef*input){GscEntityRef ref;if(!input||!DropBuffers(input,sizeof(*input),NULL,0,NULL,0))return;ref=*input;if(ref.slot<MAX_GENTITIES&&LiveItemRefEqual(&ref,&cod1Drops.rows[ref.slot].ref))cod1Drops.rows[ref.slot].touching=0;if(LiveItemRefEqual(&ref,&cod1DropPickup.item))memset(&cod1DropPickup,0,sizeof(cod1DropPickup));}
int G_Cod1DroppedItemPickupCommit(const GscEntityRef*input,int respawn){GscEntityRef ref;C1DroppedRow*r;gentity_t*e;if(!input||!DropBuffers(input,sizeof(*input),NULL,0,NULL,0))return 1;ref=*input;if(ref.slot>=MAX_GENTITIES||!G_Cod1EntitySameAllocation(&ref))return 1;r=cod1Drops.rows+ref.slot;e=g_entities+ref.slot;
 /* Acquisition is committed. No callback-current test may revive the item
  * if the Session stopped afterward. Never adopt a replacement allocation. */
 if(!LiveItemRefEqual(&ref,&r->ref)||!r->touching||e->client||e->r.bmodel||e->neverFree||cod1ActorByEntity[ref.slot]||e->s.eType!=ET_ITEM||e->item!=bg_itemlist+r->itemIndex||e->classname!=r->classname)return 1;
 if(respawn!=-1){DropQuarantine(r);return 1;}
 G_FreeEntity(e);if(G_Cod1EntitySameAllocation(&ref)){DropQuarantine(r);return 1;}if(LiveItemRefEqual(&ref,&r->ref))memset(r,0,sizeof(*r));return 1;
}

#include "g_cod1_actor_drop_factory.inc"

/* Session teardown retires only this selection's still-owned allocations.
 * New generations/Actors are never adopted. Failed exact-owner cleanup is
 * quarantined and retained until map retirement, never reported as success. */
int G_Cod1DroppedItemsStop(uint64_t key){uint64_t epoch;int i,ok=1;if(cod1DropsStopping||!key||key!=cod1Drops.key)return 0;cod1DropsStopping=1;epoch=cod1Drops.epoch;DropActorReset();cod1DropPickup.cancelled=1;if(cod1DropCall.busy)cod1DropCall.cancelled=1;cod1Drops.key=0;cod1Drops.current=NULL;cod1Drops.user=NULL;
 for(i=0;i<MAX_GENTITIES;i++){C1DroppedRow*r=cod1Drops.rows+i;GscEntityRef ref=r->ref;gentity_t*e;if(cod1Drops.epoch!=epoch){ok=0;break;}if(!ref.epoch)continue;if(!G_Cod1EntitySameAllocation(&ref)){memset(r,0,sizeof(*r));continue;}e=g_entities+ref.slot;
  if(!e->client&&!e->r.bmodel&&!e->neverFree&&!cod1ActorByEntity[ref.slot]&&e->s.eType==ET_ITEM&&e->classname==r->classname){G_FreeEntity(e);if(cod1Drops.epoch!=epoch){ok=0;break;}if(!G_Cod1EntitySameAllocation(&ref)){if(LiveItemRefEqual(&ref,&r->ref))memset(r,0,sizeof(*r));continue;}if(LiveItemRefEqual(&ref,&r->ref))DropQuarantine(r);}
  ok=0;
 }
 if(cod1Drops.epoch==epoch){memset(cod1Drops.queue,0,sizeof(cod1Drops.queue));memset(&cod1DropPickup,0,sizeof(cod1DropPickup));}cod1DropsStopping=0;return ok;
}
