 if(!G_Cod1EntityCapture(g_entities,&cod1DropCall.player))goto done;memcpy(cod1DropCall.playerOrigin,g_entities[0].r.currentOrigin,12);memcpy(cod1DropCall.queueRefs,cod1Drops.queue,sizeof(cod1Drops.queue));memset(queue,0,sizeof(queue));for(i=0;i<32;i++){GscEntityRef old=cod1Drops.queue[i];if(!old.epoch)continue;queue[i].entity=old.slot;queue[i].inuse=G_Cod1EntitySameAllocation(&old)?1:0;cod1DropCall.queueAlive[i]=queue[i].inuse;if(queue[i].inuse){memcpy(queue[i].origin,g_entities[old.slot].r.currentOrigin,12);memcpy(cod1DropCall.queueOrigins[i],queue[i].origin,12);}}cod1DropCall.queuePinned=1;if(!g_entities[0].inuse||!C1DQ_Plan(queue,g_entities[0].r.currentOrigin,level.time,&plan)||!DropFence(NULL)||level.num_entities>ENTITYNUM_MAX_NORMAL||(level.num_entities==ENTITYNUM_MAX_NORMAL&&!G_EntitiesFree()))goto done;
 e=G_Spawn();if(!G_Cod1EntityCapture(e,&ref))goto done;if(level.num_entities!=cod1DropCall.count&&(ref.slot!=(unsigned)cod1DropCall.count||level.num_entities!=cod1DropCall.count+1))goto done;cod1DropCall.count=level.num_entities;cod1DropCall.hasItem=1;cod1DropCall.ref=ref;cod1DropCall.before=*e;if(!DropFence(NULL)||e->client||e->r.bmodel||e->neverFree||cod1ActorByEntity[ref.slot])goto done;
