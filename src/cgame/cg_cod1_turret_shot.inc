/* Original MG42 WeaponDef/CSV/WAV/EFX cached during level loading only.
 * Actual native WAV looping with port range/integer-volume mixer. Random loop
 * pitch metadata is retained; loop pitch modulation is not implemented. */
#define C1TS_PACKET_ENTITY_STATE 1
#include "../game/bg_cod1_turret_shot_packet.h"
#undef C1TS_PACKET_ENTITY_STATE
#include "../game/bg_cod1_turret_wire.h"
