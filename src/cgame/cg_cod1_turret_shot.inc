#define C1TC_VARIANTS 16
#define C1TC_FILES 512
#define C1TC_LIST 65536
typedef struct {cwSoundAliasVariant value;sfxHandle_t handle;float slaveCap;} C1TCVariant;
typedef struct {int count;C1TCVariant variants[C1TC_VARIANTS];} C1TCAlias;
typedef struct {uint64_t epoch;uint32_t generation;int serial,lastKind,active,variant;float gain,pitch;} C1TCLoop;
static struct {int initialized,ready,flash;uint64_t revision,efxGeneration;uint32_t rng;C1TCAlias loop,stop;C1TCLoop owner[MAX_GENTITIES];} cgTurretShot;
static float C1TC_Unit(void){cgTurretShot.rng=cgTurretShot.rng*214013u+2531011u;return ((cgTurretShot.rng>>16)&32767u)*(1.0f/32768.0f);}
static int C1TC_Pick(const C1TCAlias*a){float sum=0,pick;int i;for(i=0;i<a->count;i++)sum+=a->variants[i].value.probability;if(sum<=0)return (int)(C1TC_Unit()*a->count)%a->count;pick=C1TC_Unit()*sum;for(i=0;i<a->count;i++){pick-=a->variants[i].value.probability;if(pick<=0)return i;}return a->count-1;}
static void C1TC_LoopBegin(C1TCLoop*r){const cwSoundAliasVariant*v;r->variant=C1TC_Pick(&cgTurretShot.loop);v=&cgTurretShot.loop.variants[r->variant].value;r->gain=v->volumeMin+(v->volumeMax-v->volumeMin)*C1TC_Unit();r->pitch=v->pitchMin+(v->pitchMax-v->pitchMin)*C1TC_Unit();r->active=1;}
void CG_Cod1TurretShotReset(void){uint64_t next=cgTurretShot.revision+1;CG_Cod1EfxAttachedRetire();memset(&cgTurretShot,0,sizeof(cgTurretShot));cgTurretShot.revision=next?next:1;cgTurretShot.rng=0x232f001u;}
static int C1TC_Read(const char*path,char**out,int maximum){fileHandle_t f=0;int n=trap_FS_FOpenFile(path,&f,FS_READ);*out=NULL;if(!f||n<=0||n>maximum){if(f)trap_FS_FCloseFile(f);return 0;}*out=malloc((size_t)n+1);if(!*out){trap_FS_FCloseFile(f);return 0;}trap_FS_Read(*out,n,f);trap_FS_FCloseFile(f);(*out)[n]=0;return n;}
static int C1TC_NameCompare(const void*a,const void*b){return strcmp(a,b);}
typedef struct {uint64_t revision,efx;} C1TCLoadLease;
static int C1TC_LoadCurrent(void*);
static int C1TC_LoadAliases(const char*loop,const char*stop,C1TCAlias staged[2],C1TCLoadLease*lease){char*list=calloc(1,C1TC_LIST),(*names)[MAX_QPATH]=calloc(C1TC_FILES,MAX_QPATH);int count,i,k,pos=0,total=0;if(!list||!names){free(list);free(names);return 0;}count=trap_Cod1FS_GetFileList("soundaliases",".csv",list,C1TC_LIST);if(!C1TC_LoadCurrent(lease)||count<0||count>=C1TC_FILES)goto fail;for(i=0;i<count;i++){size_t n=0;if(pos>=C1TC_LIST)goto fail;while(pos+(int)n<C1TC_LIST&&list[pos+n])n++;if(pos+(int)n>=C1TC_LIST)goto fail;if(!n||n>=MAX_QPATH||pos+(int)n+1>=C1TC_LIST||strstr(list+pos,"..")||strchr(list+pos,'/')||strchr(list+pos,'\\'))goto fail;memcpy(names[i],list+pos,n+1);pos+=(int)n+1;}qsort(names,count,MAX_QPATH,C1TC_NameCompare);
 for(i=0;i<count;i++){char path[128],*text;int bytes;snprintf(path,sizeof(path),"soundaliases/%s",names[i]);bytes=C1TC_Read(path,&text,4*1024*1024);if(!C1TC_LoadCurrent(lease)){free(text);goto fail;}if(!bytes)continue;total+=bytes;if(total>16*1024*1024){free(text);goto fail;}
  for(k=0;k<2;k++){C1TCAlias*a=&staged[k];cwSoundAliasVariant rows[C1TC_VARIANTS+1];int n,j;if(a->count)continue;n=CW_SoundAliasVariants(text,bytes,k?stop:loop,rows,C1TC_VARIANTS+1);if(n>C1TC_VARIANTS){free(text);goto fail;}for(j=0;j<n;j++){sfxHandle_t h;if(!CW_SoundAliasLoadSpecMatches(rows[j].loadspec,cgs.mapname))continue;{char*wav;int wavBytes;if(strcmp(rows[j].channel,k?"auto":"weapon")){free(text);goto fail;}wavBytes=C1TC_Read(rows[j].path,&wav,4*1024*1024);if(!C1TC_LoadCurrent(lease)||wavBytes<12||memcmp(wav,"RIFF",4)||memcmp(wav+8,"WAVE",4)){free(wav);free(text);goto fail;}free(wav);}h=trap_S_RegisterSound(rows[j].path);if(!C1TC_LoadCurrent(lease)||!h){free(text);goto fail;}if(!rows[j].masterSlave[0]||!Cod1SS_Number(rows[j].masterSlave,0,&a->variants[a->count].slaveCap)){free(text);goto fail;}a->variants[a->count].value=rows[j];a->variants[a->count++].handle=h;}}
  free(text);if(staged[0].count&&staged[1].count)break;
 }free(list);free(names);return C1TC_LoadCurrent(lease)&&staged[0].count&&staged[1].count;
 fail:free(list);free(names);return 0;
}
static int C1TC_LoadCurrent(void*opaque){C1TCLoadLease*l=opaque;return l&&cg.loading&&cgs.cod1MapEntities&&cgTurretShot.initialized&&cgTurretShot.revision==l->revision&&CG_Cod1EfxGeneration()==l->efx;}
void CG_Cod1TurretShotInit(void){char*text=NULL;int bytes,flashHandle;cwDef_t weapon;const char*loop,*stop,*flash;C1TCAlias staged[2];C1TCLoadLease lease;CG_Cod1TurretShotReset();CG_Cod1EfxAttachedResolver(CG_Cod1TurretFlashFrame);cgTurretShot.initialized=1;if(!cgs.cod1MapEntities||!cg.loading)return;memset(staged,0,sizeof(staged));lease.revision=cgTurretShot.revision;lease.efx=CG_Cod1EfxGeneration();bytes=C1TC_Read("weapons/sp/mg42_bipod_stand",&text,16384);if(!C1TC_LoadCurrent(&lease)||!bytes){free(text);return;}if(CW_Parse(&weapon,"mg42_bipod_stand",text,bytes)<0||strcmp(CW_String(&weapon,"weaponType"),"bullet")||CW_Number(&weapon,"rifleBullet")!=1){free(text);return;}loop=CW_String(&weapon,"loopFireSound");stop=CW_String(&weapon,"stopFireSound");flash=CW_String(&weapon,"worldFlashEffect");if(!loop||!*loop||!stop||!*stop||!flash||strncmp(flash,"fx/",3)||strstr(flash,"..")||!C1TC_LoadAliases(loop,stop,staged,&lease)){free(text);if(C1TC_LoadCurrent(&lease))CG_Printf("CoD1 MG42: original loop/cooldown media unavailable.\n");return;}
 flashHandle=CG_Cod1EfxAttachedRegister(flash,C1TC_LoadCurrent,&lease);free(text);if(!C1TC_LoadCurrent(&lease))return;CG_Cod1ImpactPrepare();if(!C1TC_LoadCurrent(&lease))return;cgTurretShot.loop=staged[0];cgTurretShot.stop=staged[1];cgTurretShot.efxGeneration=lease.efx;cgTurretShot.flash=flashHandle;cgTurretShot.ready=1;CG_Printf("CoD1 MG42: original loop/cooldown cached; worldFlash=%d%s; loop pitch remains unity, integer-volume port gain.\n",flashHandle,flashHandle?"":" (unsupported; no substitute effect)");
}
/* Persistent owner authority is the current snapshot, never an old event or cent cache. */
static const entityState_t*C1TC_Owner(int owner,uint64_t epoch,uint32_t generation){const entityState_t*found=NULL;int i;if(!cg.snap||!cgs.cod1MapEntities||owner<MAX_CLIENTS||owner>=ENTITYNUM_MAX_NORMAL||cg.snap->numEntities<0||cg.snap->numEntities>MAX_ENTITIES_IN_SNAPSHOT)return NULL;for(i=0;i<cg.snap->numEntities;i++)if(cg.snap->entities[i].number==owner){if(found)return NULL;found=&cg.snap->entities[i];}if(!found||!C1TW_Valid(found,cg.snap->serverTime)||(found->eFlags&EF_NODRAW)||!cgs.gameModels[found->modelindex]||strcmp(CG_ConfigString(CS_MODELS+found->modelindex),COD1_TURRET_MODEL_ALIAS)||(uint32_t)found->cod1TurretGeneration!=generation||((uint64_t)(uint32_t)found->cod1TurretEpochLo|((uint64_t)(uint32_t)found->cod1TurretEpochHi<<32))!=epoch)return NULL;return found;}
int CG_Cod1TurretFlashFrame(int owner,uint64_t epoch,uint32_t generation,float out[16]){
 const entityState_t*s=C1TC_Owner(owner,epoch,generation);entityState_t copy;cod1TurretRenderState_t state;snapshot_t*snapshot;float matrix[16];int i,j,k,model,time=cg.time,snapshotTime;uint64_t revision=cgTurretShot.revision;
 if(!out||!s||!s->cod1TurretAnimated||s->cod1TurretTick!=cg.snap->serverTime)return 0;copy=*s;snapshot=cg.snap;snapshotTime=snapshot->serverTime;model=cgs.gameModels[s->modelindex];memset(&state,0,sizeof(state));state.version=COD1_TURRET_RENDER_VERSION;state.size=sizeof(state);state.hModel=model;state.ownerNum=owner;state.epochLo=s->cod1TurretEpochLo;state.epochHi=s->cod1TurretEpochHi;state.generation=generation;state.sampleTick=s->cod1TurretTick;
 VectorCopy(s->pos.trBase,state.origin);VectorCopy(s->apos.trBase,state.baseAngles);VectorCopy(s->cod1TurretAngles,state.controlAngles);state.animated=1;memcpy(state.phases,s->cod1TurretPhases,8);memcpy(state.weights,s->cod1TurretWeights,8);
 if(!trap_R_Cod1TurretTagFlash(&state,matrix)||revision!=cgTurretShot.revision||cg.time!=time||cg.snap!=snapshot||snapshot->serverTime!=snapshotTime||(s=C1TC_Owner(owner,epoch,generation))==NULL||memcmp(s,&copy,sizeof(copy))||cgs.gameModels[copy.modelindex]!=model)return 0;
 for(i=0;i<16;i++)if(!(matrix[i]>=-1000000&&matrix[i]<=1000000))return 0;
 for(i=0;i<3;i++)for(j=i;j<3;j++){double dot=0;for(k=0;k<3;k++)dot+=(double)matrix[4*i+k]*matrix[4*j+k];if(fabs(dot-(i==j?1.:0.))>.001)return 0;}
 {double d=(double)matrix[0]*(matrix[5]*matrix[10]-matrix[6]*matrix[9])-(double)matrix[4]*(matrix[1]*matrix[10]-matrix[2]*matrix[9])+(double)matrix[8]*(matrix[1]*matrix[6]-matrix[2]*matrix[5]);if(fabs(d-1.)>.001)return 0;}
 memcpy(out,matrix,64);return 1;
}
typedef struct {uint64_t revision,epoch,efx;uint32_t generation;int owner,serial,kind;} C1TCLease;
static int C1TC_Current(void*opaque){C1TCLease*l=opaque;C1TCLoop*r=&cgTurretShot.owner[l->owner];return C1TC_Owner(l->owner,l->epoch,l->generation)&&cgTurretShot.ready&&cgTurretShot.revision==l->revision&&CG_Cod1EfxGeneration()==l->efx&&r->epoch==l->epoch&&r->generation==l->generation&&r->serial==l->serial&&r->lastKind==l->kind;}
qboolean CG_Cod1TurretShotEvent(const entityState_t*s){c1tsPacket_t p;C1TCLoop*r;C1TCLease lease;int firstReceipt;if(!s)return qfalse;
 if(s->eType==ET_EVENTS+EV_COD1_TURRET_IMPACT){if(s->weapon==C1TS_WEAPON_CLASS&&CI_IsEvent(s))CG_Cod1BulletImpact(s);return qtrue;}
 if(s->eType!=ET_EVENTS+EV_COD1_TURRET_SHOT)return qfalse;if(!cg.snap||!C1TSP_Decode(s,cg.snap->serverTime,&p)||!C1TC_Owner(p.owner,p.epoch,p.generation))return qtrue;r=&cgTurretShot.owner[p.owner];if(r->epoch!=p.epoch||r->generation!=p.generation){memset(r,0,sizeof(*r));r->epoch=p.epoch;r->generation=p.generation;}
 if(p.serial<r->serial||(p.serial==r->serial&&(p.kind==C1TS_EVENT_SHOT||r->lastKind==C1TS_EVENT_STOP)))return qtrue;firstReceipt=r->serial==0;r->serial=p.serial;r->lastKind=p.kind;
 memset(&lease,0,sizeof(lease));lease.revision=cgTurretShot.revision;lease.epoch=p.epoch;lease.generation=p.generation;lease.efx=cgTurretShot.efxGeneration;lease.owner=p.owner;lease.serial=p.serial;lease.kind=p.kind;
 if(p.kind==C1TS_EVENT_STOP){r->active=0;if(cgTurretShot.ready){int pick=C1TC_Pick(&cgTurretShot.stop);const C1TCVariant*v=&cgTurretShot.stop.variants[pick];float gain=v->value.volumeMin+(v->value.volumeMax-v->value.volumeMin)*C1TC_Unit(),pitch=v->value.pitchMin+(v->value.pitchMax-v->value.pitchMin)*C1TC_Unit();if(C1TC_Current(&lease)){cod1AliasSlaveRequest sound;memset(&sound,0,sizeof(sound));sound.entity=p.owner;sound.channel=CHAN_AUTO;sound.handle=v->handle;VectorCopy(p.point,sound.origin);sound.gain=gain;sound.pitch=pitch;sound.dist_min=v->value.distMin;sound.dist_max=v->value.distMax;sound.slave_cap=v->slaveCap;trap_Cod1AliasSlave(&sound);}}if(C1TC_Current(&lease))CG_Printf("[R234] CG MG42 STOP owner=%d serial=%d snapshot=%d\n",p.owner,p.serial,cg.snap->serverTime);return qtrue;}
 if(!cgTurretShot.ready)return qtrue;if(!r->active)C1TC_LoopBegin(r);if(cgTurretShot.flash&&C1TC_Current(&lease))CG_Cod1EfxAttachedPlay(cgTurretShot.flash,p.owner,p.epoch,p.generation,C1TC_Current,&lease);if(firstReceipt&&C1TC_Current(&lease))CG_Printf("[R234] CG MG42 SHOT owner=%d serial=%d snapshot=%d flash=%d\n",p.owner,p.serial,cg.snap->serverTime,cgTurretShot.flash);return qtrue;
}
void CG_Cod1TurretShotLoop(const entityState_t*s){C1TCLoop*r;uint64_t epoch;const C1TCVariant*v;int volume,range;vec3_t zero={0,0,0};if(!s||!cg.snap||!cgTurretShot.ready||!cgs.cod1MapEntities||!C1TW_Valid(s,cg.snap->serverTime)||(s->eFlags&EF_NODRAW)||strcmp(CG_ConfigString(CS_MODELS+s->modelindex),COD1_TURRET_MODEL_ALIAS))return;epoch=(uint64_t)(uint32_t)s->cod1TurretEpochLo|((uint64_t)(uint32_t)s->cod1TurretEpochHi<<32);if(!C1TC_Owner(s->number,epoch,(uint32_t)s->cod1TurretGeneration)||memcmp(C1TC_Owner(s->number,epoch,(uint32_t)s->cod1TurretGeneration),s,sizeof(*s)))return;r=&cgTurretShot.owner[s->number];if(r->epoch!=epoch||r->generation!=(uint32_t)s->cod1TurretGeneration){memset(r,0,sizeof(*r));r->epoch=epoch;r->generation=s->cod1TurretGeneration;}if(!s->loopSound){r->active=0;return;}if(s->loopSound!=1)return;if(!r->active)C1TC_LoopBegin(r);v=&cgTurretShot.loop.variants[r->variant];volume=(int)(r->gain*255);if(volume>255)volume=255;if(volume<0)volume=0;range=(int)(v->value.distMax/1.064f);if(range<1)range=1250;{cod1AliasSlaveRequest sound;memset(&sound,0,sizeof(sound));sound.looping=1;sound.entity=s->number;sound.channel=CHAN_WEAPON;sound.handle=v->handle;VectorCopy(s->pos.trBase,sound.origin);sound.range=range;sound.volume=volume;sound.slave_cap=v->slaveCap;trap_Cod1AliasSlave(&sound);}
}
